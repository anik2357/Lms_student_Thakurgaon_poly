# Copy this file to  backend/.env  (or the project root) and edit it: the app loads it on start.
# Real environment variables (shell, Render dashboard, docker -e) always take priority over this file.
# Never commit your real .env (it is in .gitignore).

# REQUIRED in production: a long random string, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
LMS_SECRET_KEY=change-me

# PostgreSQL. Option A: one URL (Render and most hosts provide it as DATABASE_URL).
# DATABASE_URL=postgresql://lms:change-me@127.0.0.1:5432/lms
# Option B: separate settings. The database is created automatically if the user has CREATEDB.
LMS_DB_HOST=127.0.0.1
LMS_DB_PORT=5432
LMS_DB_USER=lms
LMS_DB_PASSWORD=change-me
LMS_DB_NAME=lms
# Only for connecting to a hosted database from OUTSIDE its network (e.g. Render's *external* URL):
# LMS_DB_SSLMODE=require

# Optional: create the first administrator at startup when no admin exists (handy where there is no shell).
# LMS_ADMIN_EMAIL=you@school.edu
# LMS_ADMIN_PASSWORD=choose-a-strong-password
# LMS_ADMIN_NAME=Administrator

LMS_UPLOAD_DIR=./uploads
LMS_MAX_UPLOAD_MB=10
LMS_TOKEN_MINUTES=720

# Create demo accounts when the database is empty. Set to 0 in production.
LMS_AUTO_SEED=1

# Only needed if the frontend is hosted on a different origin (comma separated).
# LMS_CORS_ORIGINS=https://lms.example.com
